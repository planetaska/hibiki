<h1>Hibiki cable spike — todos (Phlex)</h1>

<div data-controller="todos" data-todos-cid-value="<%= @cid %>">
  <%= turbo_stream_from "todos", @cid %>

  <%# A throwaway instance as a paint-avoidance placeholder; the channel's
      long-lived instance takes over from its first broadcast, which always
      lands because the controller subscribes only after the Turbo stream
      confirms (stream_connected.js). %>
  <%= render TodoList.new %>

  <form data-action="submit->todos#add">
    <input type="text" data-todos-target="title" placeholder="new todo">
    <button>add</button>
  </form>
</div>

<p><a href="/">&larr; ERB stage</a></p>
